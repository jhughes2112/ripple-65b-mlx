+# ---- the Ripple target itself, loaded from RICURSIVE_PY
+
+_PORT = os.environ.get("RICURSIVE_PY")
+needs_port = pytest.mark.skipif(not _PORT, reason="set RICURSIVE_PY to the port's ricursive.py")
+WINDOW = 8
+
+
+def _ripple():
+    spec = importlib.util.spec_from_file_location("mlx_lm.models.ricursive", _PORT)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    args = module.ModelArgs(
+        model_type="ricursive", hidden_size=HIDDEN, intermediate_size=48, num_hidden_layers=6,
+        num_attention_heads=8, num_key_value_heads=2, head_dim=8, vocab_size=VOCAB,
+        layer_types=["sliding_attention"] * 4 + ["full_attention"] * 2, sliding_window=WINDOW,
+        embed_scale=5.5, ffn_clamp_threshold=20.0,
+    )
+    mx.random.seed(3)
+    model = module.Model(args)
+    mx.eval(model.parameters())
+    return model
+
+
+@needs_port
+def test_drafter_binds_to_the_ripple_target_with_its_embedding_scale():
+    target = _ripple()
+    drafter_target.apply(target)
+    draft = DFlash2DraftModel(_config())
+    draft.bind(target)
+    assert draft.embed_scale == 5.5
+    assert draft.embed_tokens is target.model.embed_tokens
+    assert draft.lm_head is target.lm_head
