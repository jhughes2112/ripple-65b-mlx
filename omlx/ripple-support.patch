+    h = target.model.embed_tokens(ids) * 5.5
+    drafter_target.apply(target)
+    out = target(ids, target.make_cache(), capture_layer_ids=TARGET_LAYER_IDS)
+    assert len(out.hidden_states) == len(TARGET_LAYER_IDS)
+    assert all(c.shape == (1, 12, HIDDEN) for c in out.hidden_states)
+    assert _worst(out.logits, plain) < 1e-3
+    assert h.shape == (1, 12, HIDDEN)
