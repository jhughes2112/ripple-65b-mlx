+@needs_port
+def test_rollback_past_the_window_keeps_the_logits():
+    target = _ripple()
+    drafter_target.apply(target)
+    ids = mx.random.randint(0, VOCAB, (1, 40))
+    wrong = mx.random.randint(0, VOCAB, (1, 40))
+    expected = target(ids)
+    cache = target.make_cache()
+    outs = []
+    for position in range(40):
+        row = mx.concatenate([ids[:, position : position + 1], wrong[:, position : position + 3]], axis=1)
+        out = target(row, cache=cache)
+        outs.append(out[:, :1])
+        assert target.mtp_partial_rollback(cache, 0, row.shape[1] - 1)
+    assert _worst(mx.concatenate(outs, axis=1), expected) < TOLERANCE
