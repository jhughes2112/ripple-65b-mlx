diff --git a/tests/test_dflash_mixed_layers.py b/tests/test_dflash_mixed_layers.py
new file mode 100644
index 00000000..4ca66239
--- /dev/null
+++ b/tests/test_dflash_mixed_layers.py
@@ -0,0 +1,301 @@
+"""DFlash2 drafts that mix sliding and full-attention layers, with a NoPE layer, as Ripple-65B's does."""
+
+from __future__ import annotations
+
+import importlib.util
+import os
+from types import SimpleNamespace
+
+import mlx.core as mx
+import mlx.nn as nn
+import pytest
+from mlx_vlm.speculative.drafters.dflash2.config import DFlash2Config
+from mlx_vlm.speculative.drafters.dflash2.dflash2 import DFlash2DraftModel
+
+from omlx.model_settings import MAX_LIGHTNING_MTP_DRAFT_TOKENS
+from omlx.patches.mlx_lm_mtp import drafter_target
+from omlx.speculative import dflash as dd
+from omlx.speculative.dflash import kernels
+from omlx.utils.model_loading import dflash_batched_supported
+
+VOCAB, HIDDEN, BLOCK = 64, 32, 4
+SLIDING, FULL_WINDOW = 6, 20
+LAYER_TYPES = ["sliding_attention", "sliding_attention", "full_attention"]
+TARGET_LAYER_IDS = [1, 3, 5]
+NO_ROPE = [2]
+# The M5 GPU's float32 matmul is noisy past one row, enough to hide the NoPE rule entirely, so these
+# comparisons run on the CPU. The convolutions' Metal kernels get their own test below.
+TOLERANCE = 2e-5
+
+
+@pytest.fixture(autouse=True)
+def cpu_with_composed_convolutions(monkeypatch):
+    previous = mx.default_device()
+    mx.set_default_device(mx.cpu)
+    monkeypatch.setattr(kernels, "conv_prepare", lambda conv, hidden: conv.prepare(hidden))
+    monkeypatch.setattr(kernels, "conv_finish", lambda conv, hidden, dynamic: conv.finish(hidden, dynamic))
+    yield
+    mx.set_default_device(previous)
+
+
+def _config():
+    return DFlash2Config.from_dict({
+        "model_type": "qwen3",
+        "hidden_size": HIDDEN,
+        "intermediate_size": 48,
+        "num_hidden_layers": 3,
+        "num_attention_heads": 8,
+        "num_key_value_heads": 2,
+        "head_dim": 8,
+        "vocab_size": VOCAB,
+        "rms_norm_eps": 1e-6,
+        "max_position_embeddings": 4096,
+        "num_target_layers": 6,
+        "sliding_window": SLIDING,
+        "layer_types": LAYER_TYPES,
+        "rope_parameters": {"rope_theta": 10000.0, "rope_type": "default"},
+        "tie_word_embeddings": False,
+        "dflash_config": {
+            "block_size": BLOCK,
+            "conv_group_size": 8,
+            "conv_kernel_size": 4,
+            "mask_token_id": VOCAB - 1,
+            "selector_rank": 8,
+            "selector_top_k": 4,
+            "target_layer_ids": TARGET_LAYER_IDS,
+        },
+    })
+
+
+def _target():
+    embed, lm_head = nn.Embedding(VOCAB, HIDDEN), nn.Linear(HIDDEN, VOCAB, bias=False)
+    mx.eval(embed.parameters(), lm_head.parameters())
+    return SimpleNamespace(language_model=SimpleNamespace(
+        config={"text_config": {"hidden_size": HIDDEN, "num_hidden_layers": 6, "vocab_size": VOCAB}},
+        model=SimpleNamespace(layers=[object()] * 6, embed_tokens=embed),
+        lm_head=lm_head,
+        rollback_speculative_cache=lambda *args, **kwargs: None,
+    ))
+
+
+def _model(seed=0):
+    mx.random.seed(seed)
+    model = DFlash2DraftModel(_config())
+    params = [(k, mx.random.normal(v.shape) * 0.2) for k, v in nn.utils.tree_flatten(model.parameters())]
+    model.load_weights(params, strict=False)
+    model.bind(_target())
+    mx.eval(model.parameters())
+    return model
+
+
+def _drafter(model, *, no_rope=tuple(NO_ROPE), windows=(SLIDING, SLIDING, None), query_windows=False):
+    drafter = dd.DFlashDrafter(
+        model, block_size=BLOCK, source_path="tiny", window_size=FULL_WINDOW,
+        no_rope_layers=no_rope, layer_windows=windows,
+    )
+    drafter.query_windows = query_windows
+    return drafter
+
+
+def _oracle(model, features, anchor, *, no_rope=tuple(NO_ROPE), windows=(SLIDING, SLIDING, None), query_windows=False):
+    """Plain forward over the whole history: no rings, and each layer's rules written out directly."""
+    total = features.shape[1]
+    context = model.hidden_norm(model.fc(features))
+    inputs = mx.concatenate([mx.array([[anchor]], dtype=mx.int32), mx.full((1, BLOCK - 1), VOCAB - 1, dtype=mx.int32)], axis=1)
+    h = model._embed_input_tokens(inputs)
+    for i, layer in enumerate(model.layers):
+        attn = layer.self_attn
+        rotate = (lambda x, offset: x) if i in no_rope else (lambda x, offset: model.rope(x, offset=offset))
+        attended = (windows[i] or FULL_WINDOW) - 1
+        residual = h
+        x, kernel = layer.attention_conv.prepare(layer.input_layernorm(h))
+        q = attn.q_norm(attn.q_proj(x).reshape(1, BLOCK, attn.n_heads, -1)).transpose(0, 2, 1, 3)
+        bk = attn.k_norm(attn.k_proj(x).reshape(1, BLOCK, attn.n_kv_heads, -1)).transpose(0, 2, 1, 3)
+        bv = attn.v_proj(x).reshape(1, BLOCK, attn.n_kv_heads, -1).transpose(0, 2, 1, 3)
+        ck = attn.k_norm(attn.k_proj(context).reshape(1, total, attn.n_kv_heads, -1)).transpose(0, 2, 1, 3)
+        cv = attn.v_proj(context).reshape(1, total, attn.n_kv_heads, -1).transpose(0, 2, 1, 3)
+        q, bk, ck = rotate(q, total), rotate(bk, total), rotate(ck, 0)
+        start = max(0, total - attended)
+        if query_windows:
+            # Each query's window ends at its own position, so later queries see fewer context rows.
+            positions = mx.arange(start, total)
+            lower = total + mx.arange(BLOCK) - attended
+            context_part = positions[None, :] >= lower[:, None]
+            mask = mx.concatenate([context_part, mx.ones((BLOCK, BLOCK), dtype=mx.bool_)], axis=1)[None, None]
+        else:
+            mask = None
+        out = mx.fast.scaled_dot_product_attention(
+            q, mx.concatenate([ck[:, :, start:], bk], axis=2), mx.concatenate([cv[:, :, start:], bv], axis=2),
+            scale=attn.scale, mask=mask,
+        )
+        out = attn.o_proj(out.transpose(0, 2, 1, 3).reshape(1, BLOCK, -1))
+        h = residual + layer.attention_conv.finish(out, kernel)
+        residual = h
+        x, kernel = layer.mlp_conv.prepare(layer.post_attention_layernorm(h))
+        h = residual + layer.mlp_conv.finish(layer.mlp(x), kernel)
+    return model.norm(h)[:, 1:]
+
+
+def _run(model, drafter, steps=(5, 1, 3, 9, 2, 14, 1, 30), seed=7):
+    """Drafts after each step of new context, returning (draft hidden, oracle features, anchor) per step."""
+    mx.random.seed(seed)
+    history = mx.zeros((1, 0, HIDDEN * len(TARGET_LAYER_IDS)))
+    state = SimpleNamespace(uid=1, depth=BLOCK - 1, controller=None, stats=None)
+    recorded, original = [], model._logits
+
+    def record(hidden):
+        recorded.append(hidden)
+        return original(hidden)
+
+    model._logits = record
+    results = []
+    try:
+        for n, count in enumerate(steps):
+            captured = [mx.random.normal((1, count, HIDDEN)) * 0.3 for _ in TARGET_LAYER_IDS]
+            history = mx.concatenate([history, mx.concatenate(captured, axis=-1)], axis=1)
+            anchor = n + 3
+            drafter.draft([(None, state, captured, mx.array([anchor]), None)])
+            mx.eval(state.drafts)
+            results.append((recorded[-1], history, anchor))
+    finally:
+        model._logits = original
+    return results
+
+
+def _worst(a, b):
+    return mx.abs(a.astype(mx.float32) - b.astype(mx.float32)).max().item()
+
+
+def test_matches_a_plain_forward_with_each_layers_rules():
+    model = _model()
+    for hidden, history, anchor in _run(model, _drafter(model)):
+        assert _worst(hidden, _oracle(model, history, anchor)) < TOLERANCE
+
+
+def test_query_anchored_windows_match_the_plain_forward():
+    model = _model()
+    for hidden, history, anchor in _run(model, _drafter(model, query_windows=True)):
+        assert _worst(hidden, _oracle(model, history, anchor, query_windows=True)) < TOLERANCE
+
